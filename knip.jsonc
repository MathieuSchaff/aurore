{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "**/dist/**",
    "**/.audit-out/**",
    "vendor/**",
    "frontend/src/routeTree.gen.ts",
    "backend/drizzle.config.ts",
    "docs/**"
  ],
  "tags": ["-knipignore"],
  "ignoreBinaries": ["magick"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,js,mjs}"],
      "ignoreDependencies": ["@biomejs/biome", "madge", "fallow"]
    },
    "backend": {
      "entry": [
        "src/db/migrate.ts",
        "src/**/main.ts",
        "src/**/*.cli.ts",
        "src/db/seed/seeders/*.ts",
        "src/db/seed/maintenance/*.ts",
        "src/db/seed/inci/**/*.ts",
        "src/db/seed/**/audit-*.ts",
        "src/db/seed/**/scan-*.ts",
        "src/db/seed/**/fix-*.ts",
        "src/db/seed/**/index.ts",
        "src/db/audit/*.ts",
        "src/features/auto-tagging/runners/**/*.ts",
        "src/images/audit/*.ts",
        "src/images/maintenance/*.ts",
        "src/images/upload/*.ts",
        "src/tests/**/*.ts",
        "scripts/*.ts",
        "**/*.test.ts",
        "src/instrumentation.ts",
        "hono-docs.ts"
      ],
      // knip hints that "scripts/**/*.ts" matches nothing: today every nested script is a test,
      // already covered by the entry patterns. Kept so a future non-test nested script is scanned.
      "project": ["src/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "frontend": {
      // The vite/vitest/playwright plugins already contribute their own config files and
      // routeTree.gen.ts, so listing them here again is redundant.
      "entry": [
        "src/router.tsx",
        "src/client.tsx",
        "src/start.ts",
        "e2e/**/*.spec.ts",
        "e2e/helpers/*.ts",
        "e2e/csp/check.ts",
        "e2e/auth-ssr/check.ts",
        "**/*.test.{ts,tsx}",
        // Type-level assertions (@ts-expect-error): only tsc reads them, nothing imports them.
        "**/*.type-test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "vite": true,
      "vitest": true,
      "playwright": true,
      "ignoreDependencies": [
        "@tanstack/router-cli",
        "@tanstack/react-router-devtools",
        "rollup-plugin-visualizer",
        // Pulled in by CSS @import in src/styles/index.css, which knip does not parse.
        "@fontsource/dm-sans",
        "@fontsource/fraunces",
        "@fontsource/ibm-plex-mono"
      ]
    },
    "shared": {
      "entry": ["**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
