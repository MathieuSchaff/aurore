{
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true, // the frontend reads backend types straight from this emit
    "declarationMap": false,
    "emitDeclarationOnly": true, // Bun runs the TS, so only the types need emitting

    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["bun"],

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true
  },

  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/db/seed/output" // raw scraper output, gitignored, mirrors .gitignore
  ],

  // references must sit at the JSON root, not under compilerOptions
  "references": [{ "path": "../shared" }]
}
