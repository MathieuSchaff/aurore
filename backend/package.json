{
  "name": "@aurore/backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --preload ./src/instrumentation.ts --watch src/index.ts",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "start": "bun --preload ./src/instrumentation.ts src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "npx drizzle-kit studio --port 4983"
  },
  "devDependencies": {
    "@rcmade/hono-docs": "^1.4.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aurore/shared": "workspace:*",
    "@braintree/sanitize-url": "^7.1.2",
    "@getbrevo/brevo": "^6.2.0",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sindresorhus/slugify": "^3.0.1",
    "algo-derm": "file:../vendor/algo-derm.tgz",
    "arctic": "^3.7.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  }
}
