{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/drizzle/migrations",
      "!**/*.min.js",
      "!**/coverage",
      "!**/*.gen.ts",
      "!backend/src/**/*.js",
      "!**/drizzle.backup",
      "!backend/src/db/seed/output",
      "!backend/src/db/seed/data/image-fetchers",
      "!backend/src/images/fetchers/*.ts",
      "!**/_archive",
      "!.audit-out/**/*",
      "!docs",
      "!vendor",
      "!backend/src/db/seed/data/*.json",
      "!**/stats.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noRedundantRoles": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error",
        "noUnknownMediaFeatureName": "off"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "useTemplate": "warn",
        "noDescendingSpecificity": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/store/auth", "**/store/auth"],
                "message": "Auth store is internal to the session state adapter"
              },
              {
                "group": ["@/lib/auth/session", "**/auth/session", "./session"],
                "importNamePattern": "(clearSessionExpiredEvent|consumeBanEvent|endSession|installSession|recordBan|seedClientSession|updateSessionUser|useBanEvent|useSessionExpiredEvent|writeRequestBootSession)",
                "message": "Session transitions are restricted to named infrastructure writers"
              },
              {
                "group": [
                  "@/lib/auth/credential",
                  "**/auth/credential",
                  "./credential",
                  "../credential"
                ],
                "importNamePattern": "readBearerForTransport",
                "message": "Raw bearer access is restricted to transport adapters"
              },
              {
                "group": [
                  "@/lib/auth/credential",
                  "**/auth/credential",
                  "./credential",
                  "../credential"
                ],
                "importNamePattern": "(readCredentialExpiration|useCredentialExpiration)",
                "message": "Credential expiration is restricted to freshness and scheduling"
              },
              {
                "group": ["@/lib/auth/sessionState", "**/auth/sessionState", "./sessionState"],
                "message": "Raw session state is internal to session and credential adapters"
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": "off",
        "noUnknownAtRules": "off"
      }
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
