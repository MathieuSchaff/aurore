        "frontend/src/test/**/*.ts",
        "frontend/src/test/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noDocumentCookie": "off"
          }
        }
      }
    },
