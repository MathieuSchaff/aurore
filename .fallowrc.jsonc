{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Entry points beyond package.json scripts: bun:test / vitest / playwright discover their files
  // implicitly, and many CLI scripts are launched via `bun run path/to/script.ts` (justfile recipes,
  // ad-hoc tooling). Listing them explicitly stops fallow from treating them as unreachable.
  "entry": [
    "backend/src/db/seed/tests/**/*.test.ts",
    "backend/src/db/migrate.ts",
    "backend/drizzle.config.ts",
    "backend/hono-docs.ts",
    "frontend/src/router.tsx",
    "scripts/*.ts",

    // bun:test discovers these
    "backend/src/**/*.test.ts",
    "backend/src/tests/**/*.ts",
    "shared/src/**/*.test.ts",

    // vitest frontend
    "frontend/src/**/*.test.{ts,tsx}",
    "frontend/vitest.config.ts",

    // playwright e2e
    "frontend/e2e/**/*.spec.ts",
    "frontend/playwright.config.ts",

    // CLI scripts run via bun directly or justfile recipes
    "backend/src/**/*.cli.ts",
    "backend/src/db/audit/**/*.ts",
    "backend/src/db/seed/maintenance/**/*.ts",
    "backend/src/db/seed/ingest/**/main.ts",
    "backend/src/db/seed/inci/**/*.ts",
    "backend/src/db/seed/seeders/**/*.ts",
    "backend/src/images/**/*.ts",
    "backend/src/features/auto-tagging/runners/**/*.ts",

    // Loaded through postcss-global-data (postcss.config.js), never via an import
    "frontend/src/styles/tokens/breakpoints.css"
  ],

  // @aurore/shared: fallow resolves the symlink (verified on 3.10.0, dropping this entry
  // surfaces no unresolved-import), but attributes the package to a single workspace. It reports
  // it unused in frontend/package.json "(imported in backend)" while the frontend imports it widely.
  // pino-pretty: string reference in the transport config, never imported.
  // typescript-5: only consumer is scripts/audit-comments.ts, which is gitignored (local-only
  // tooling), so no analyser can see the import that justifies the dependency.
  "ignoreDependencies": ["@aurore/shared", "pino-pretty", "react-doctor", "typescript-5"],

  // docs-private/wiki carries its own package.json (Starlight). It is not application code and
  // is gitignored, so it must not be analysed nor reported as an undeclared workspace.
  // Do NOT add routeTree.gen.ts here: it is the only edge from the router to the 53 route files,
  // so ignoring it strands every route and its components (8 unused files becomes 144). Its two
  // unused generated types are the cheaper noise.
  "ignorePatterns": ["vendor/**", ".fallow/**", "**/*.d.ts", "node_modules/**", "docs-private/**"],

  // Complexity gates aligned with fallow defaults (20 cyclomatic / 15 cognitive)
  //
  // thresholdOverrides relaxes CRAP, and only CRAP, on the CLI entry points. CRAP is
  // complexity squared against a *coverage estimate* derived from export references, and a script
  // whose only caller is a justfile recipe estimates at zero coverage no matter how tested its
  // callees are. 101 of the 144 high-crap findings sit on these four surfaces for that reason
  // alone. 420 is not a taste number: a function at the cyclomatic ceiling of 20 scores 20² + 20
  // at zero coverage, so this ceiling makes CRAP silent below the gate and leaves cyclomatic and
  // cognitive (which measure the code rather than guess at its tests) enforced as before.
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "thresholdOverrides": [
      {
        "files": [
          "scripts/*.ts",
          "backend/src/features/auto-tagging/runners/**",
          "backend/src/db/seed/**",
          "backend/src/db/audit/**"
        ],
        "maxCrap": 420,
        "reason": "CLI entry points: CRAP's coverage term is estimated from export references, which reads as zero for anything a justfile recipe invokes directly"
      }
    ]
  },

  // mild mode avoids flagging structurally similar seed data objects
  // ignoreImports drops false positives from Biome-sorted import blocks
  // minLines 25: sub-25-line clones are boilerplate noise (679→21)
  // threshold is a percentage of duplicated lines, not a cap on the printed list. The repo sits
  // at 0.1%, so the previous value of 8 could never fire; 3 leaves room to grow without silence.
  "duplicates": {
    "mode": "mild",
    "minLines": 25,
    "threshold": 3,
    "ignoreImports": true
  }
}
