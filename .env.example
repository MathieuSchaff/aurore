# ==============================================================================
# 🌿 Aurore — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.dev — `just init` does it for you and rolls real JWT secrets.
# 2. The values below boot a local dev stack as-is; only the third-party keys need filling.
# 3. DO NOT commit actual .env.dev or .env.prod files to version control!
# ==============================================================================

# 🗄️ Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Password for the PostgreSQL root user. The api container derives its own
# DATABASE_URL from this, so the two must never drift apart.
POSTGRES_PASSWORD=devpassword
# Host-side connection string: `just db-migrate`, drizzle-kit and the seed runners
# read it from here. Containers get their URL from Compose, not from this line —
# so `localhost` is correct, and the port is the one the dev overlay publishes.
DATABASE_URL=postgres://app:devpassword@localhost:5432/appdb
# Runtime DB role password (used by APP_DATABASE_URL for the backend runtime pool).
# Rotate to a unique secret in production. Must match the password set via ALTER ROLE app_runtime PASSWORD '...'.
APP_RUNTIME_PASSWORD=devpassword
APP_DATABASE_URL=postgres://app_runtime:devpassword@localhost:5432/appdb

# 🔐 Authentication
# ------------------------------------------------------------------------------
# Signing keys, 32 characters minimum — the backend refuses to boot below that.
# `just init` replaces these with `openssl rand -base64 32` output; production
# refuses the placeholders outright.
JWT_SECRET=dev_only_jwt_secret_replace_before_prod
REFRESH_SECRET=dev_only_refresh_secret_replace_before_prod

# 📧 Email Service (Brevo)
# ------------------------------------------------------------------------------
# API Key for sending verification emails.
BREVO_API_KEY=your_brevo_api_key_here
# Sender identity for transactional emails. The domain MUST be authenticated in
# Brevo (DKIM/SPF/DMARC).
MAIL_FROM_EMAIL=noreply@your-domain.tld
MAIL_FROM_NAME=Aurore
# URL of your frontend (for verification links).
FRONTEND_URL=http://localhost:5173
# Production apex domain used by the edge nginx config.
# The certificate recipe also requests www.${DOMAIN} and redirects it to this apex.
DOMAIN=your-domain.tld

# 🌐 Google OAuth (Optional)
# ------------------------------------------------------------------------------
# Required if you want to enable "Login with Google".
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# 🐰 Bunny.net — Image storage + CDN
# ------------------------------------------------------------------------------
# Storage Zone name (Bunny dashboard → Storage).
BUNNY_STORAGE_ZONE=aurore-images
# Storage hostname (region-dependent: storage.bunnycdn.com for DE, ny.storage.bunnycdn.com for NY, etc.).
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
# Storage Zone → FTP & API Access → Password (read-write).
BUNNY_STORAGE_PASSWORD=your_bunny_storage_password_here
# Pull Zone CDN base URL (e.g. https://aurore-cdn.b-cdn.net). Used by patch-image-urls.ts.
IMAGE_CDN_BASE=https://your-zone.b-cdn.net

# 📈 Observability
# ------------------------------------------------------------------------------
# Backend OTel export (traces/metrics). Leave empty locally to disable the SDK.
# Point at a local collector for self-hosted traces/metrics (Phase 2/3).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=aurore-api
# Frontend Faro collector URL. Leave empty locally to disable browser telemetry.
VITE_FARO_URL=
VITE_APP_VERSION=dev

# Grafana Cloud (GRAFANA_CLOUD_*, OTEL_*) is prod-only — see .env.prod.example.
# The monitoring overlay runs on the VPS with --env-file .env.prod, never in dev.
