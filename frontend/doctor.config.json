{
  "$schema": "https://react.doctor/schema/config.json",
  "rules": {
    "react-doctor/react-compiler-no-manual-memoization": "off",
    "react-doctor/no-redundant-roles": "off",
    "react-doctor/js-set-map-lookups": "off",
    "react-doctor/js-combine-iterations": "off"
  },
  "ignore": {
    "files": ["**/*.test.tsx", ".output/**"],
    "overrides": [
      {
        "files": ["package.json"],
        "rules": ["deslop/unused-dev-dependency"]
      },
      {
        "files": ["src/component/Dialog/DialogPrimitive.tsx"],
        "rules": [
          "react-doctor/click-events-have-key-events",
          "react-doctor/jsx-no-constructed-context-values",
          "react-doctor/no-noninteractive-element-interactions"
        ]
      },
      {
        "files": ["src/features/products/components/FormulaReading/FormulaReading.tsx"],
        "rules": ["react-doctor/js-flatmap-filter"]
      },
      {
        "files": ["src/features/collection/context/CollectionFilterContext.tsx"],
        "rules": [
          "react-doctor/jsx-no-constructed-context-values",
          "react-doctor/only-export-components"
        ]
      },
      {
        "files": ["src/component/DropdownMenu/DropdownMenu.tsx"],
        "rules": ["react-doctor/jsx-no-constructed-context-values"]
      },
      {
        "files": ["src/features/legal/components/PrivacyList/PrivacyList.tsx"],
        "rules": ["react-doctor/no-array-index-as-key"]
      },
      {
        "files": ["src/store/auth.ts"],
        "rules": ["react-doctor/no-array-index-deref-without-bounds-or-empty-guard"]
      },
      {
        "files": ["src/component/ImageUpload/useImageUpload.ts"],
        "rules": ["react-doctor/no-create-object-url-without-revoke"]
      },
      {
        "files": [
          "src/features/products/components/ProductForm/ProductForm.tsx",
          "src/features/products/pages/ProductsPage/ProductsPage.tsx"
        ],
        "rules": ["react-doctor/no-giant-component"]
      },
      {
        "files": ["src/hooks/useIsBelowLg.ts"],
        "rules": ["react-doctor/no-match-media-in-state-initializer"]
      },
      {
        "files": ["src/assets/product-icons.tsx"],
        "rules": ["react-doctor/no-multi-comp", "react-doctor/only-export-components"]
      },
      {
        "files": ["src/component/Card/Card.tsx"],
        "rules": ["react-doctor/no-multi-comp"]
      },
      {
        "files": ["src/component/Filter/FilterDrawer/FilterDrawer.tsx"],
        "rules": [
          "react-doctor/no-noninteractive-element-interactions",
          "react-doctor/no-prevent-default"
        ]
      },
      {
        "files": ["src/features/blog/page/BlogListPage/BlogListPage.tsx"],
        "rules": ["react-doctor/no-reset-all-state-on-prop-change"]
      },
      {
        "files": ["src/client.tsx"],
        "rules": ["react-doctor/no-unguarded-browser-global-at-module-scope"]
      },
      {
        "files": [
          "src/component/Button/Button.tsx",
          "src/features/auth/page/LoginPage/LoginPage.tsx",
          "src/features/auth/page/ResetPasswordPage/ResetPasswordPage.tsx",
          "src/features/auth/page/SignupPage/SignupPage.tsx"
        ],
        "rules": ["react-doctor/only-export-components"]
      },
      {
        "files": ["src/features/discussions/components/SuggestEditButton.tsx"],
        "rules": ["react-doctor/prefer-useReducer"]
      },
      {
        "files": [
          "src/lib/queries/auth.ts",
          "src/lib/queries/reports.ts",
          "src/lib/queries/suggested-edits.ts"
        ],
        "rules": ["react-doctor/query-mutation-missing-invalidation"]
      }
    ]
  }
}
