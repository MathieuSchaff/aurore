# reload-certs.sh only replaces ${DOMAIN}; nginx $variables must stay literal.

# Keep API and static budgets separate. A cold SPA load once throttled /api/auth/refresh.
# Bursts must stay generous because mobile networks can share one public IP.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=static_limit:10m rate=30r/s;
# Return 429 for throttling; 503 looks like nginx or the backend is down.
limit_req_status 429;

# Nothing was compressed on the wire: the sitemap alone (800 KB of XML) was half the
# daily egress. `gzip_proxied any` is required here because every response comes from
# an upstream and the default (`off`) skips all of them. text/html is always included.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types application/xml application/json application/javascript text/javascript text/css image/svg+xml text/plain;

# A response bigger than the buffers goes to /var/cache/nginx/proxy_temp whenever the
# client drains slower than the upstream fills. The default 32k total put a product
# list over that line; 256k keeps the common payloads in memory.
proxy_buffer_size 16k;
proxy_buffers 8 32k;
proxy_busy_buffers_size 64k;

# Needed with `resolve`; Docker can give api/frontend new IPs after restarts.
resolver 127.0.0.11 valid=30s ipv6=off;

upstream api {
    zone api 64k;
    server api:3000 resolve;
}

upstream frontend {
    zone frontend 64k;
    server frontend:3000 resolve;
}
# link to check the directives of the core module
# https://nginx.org/en/docs/http/ngx_http_core_module.html
# Block HTTP (port 80) and ACME challenge + redirect to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;

    # if let's encrypt ask for the http://aurore-app.fr/.well-known/acme-challenge/abc123
    # nginx will give back this /var/www/certbot/.well-known/acme-challenge/abc123
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Docker healthcheck. it keeps port 80 reachable so we know if nginx is up
    location /nginx-health {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# Local Docker healthcheck: prevents Host: 127.0.0.1 from hitting the 444 default_server.
server {
    listen 80;
    server_name 127.0.0.1 localhost;
    server_tokens off;

    location /nginx-health {
        access_log off;
        return 200 "ok";
        add_header Content-Type text/plain;
    }
}

# Handle HTTPS for our domain on port 443.
# https://nginx.org/en/docs/http/configuring_https_servers.html

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    # https://docs.openssl.org/3.0/man1/openssl-ciphers/
    # Generated with : https://configurator.tlsref.org/ ( config nginx intermediate)
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    # HSTS, tells the browser to come only with https on future connections
    # for one year, always come back on https on this domain
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Don't try to guess which type of files, if it's image, don't treat it as javascript, don't interpret
    add_header X-Content-Type-Options "nosniff" always;
    # Don't allow my website to be in a iframe
    # it prevent clickjacking
    # https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/X-Frame-Options
    add_header X-Frame-Options "DENY" always;
    # decide if other website receive the full url.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # Severs the window.opener link a cross-origin page would otherwise keep. Safe here because the
    # app opens no popup at all: Google sign-in is a full redirect (window.location.href), not a
    # popup handshake, which is the one flow same-origin would break.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # Sources: self bundle/API, self-hosted fonts, inline styles (React), Bunny CDN + Google account avatars.
    # style-src cannot drop 'unsafe-inline' yet, and narrowing it through style-src-elem was tried
    # and refused on 2026-08-31: the SSR build emits its critical CSS as unnonced <style> elements,
    # so `just test-csp` reports style-src-elem violations on / and /products. The way out is a
    # nonce on those elements, the same one script-src already carries, not a stricter directive.
    # blob: is required for the image-upload crop preview (URL.createObjectURL on the picked file).
    # connect-src also allows the Faro RUM collector (browser POSTs telemetry to Grafana Cloud EU).
    # script-src carries a per-request nonce ($request_id, 128-bit random): the SSR app stamps it on
    # its inline hydration scripts (forwarded below as X-CSP-Nonce), so no 'unsafe-inline' is needed.
    # https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Content-Security-Policy/upgrade-insecure-requests
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'nonce-$request_id'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.b-cdn.net https://*.googleusercontent.com; connect-src 'self' https://faro-collector-prod-eu-west-2.grafana.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" always;

    location /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Dynamic sitemap lives on the backend (data = Hono); map the root path crawlers
    # expect to the API route. Exact match so it never falls through to the SPA.
    location = /sitemap.xml {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://api/api/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # /refresh and /login return the access token in the JSON body. Compressing a
    # response that carries a secret is the precondition for BREACH, so keep this
    # prefix out of gzip; the payloads are small enough that it costs nothing.
    location /api/auth/ {
        gzip off;
        limit_req zone=api_limit burst=40 nodelay;
        client_max_body_size 2m;

        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;
        # Backend bodyLimit is 1 MiB; allow that through (it returns a clean JSON error) and
        # block grossly oversized bodies here at the edge.
        client_max_body_size 2m;

        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }

    location / {
        limit_req zone=static_limit burst=100 nodelay;

        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Same $request_id used in the CSP script-src nonce above; the SSR app reads
        # it and stamps every inline hydration script so the strict CSP admits them.
        proxy_set_header X-CSP-Nonce $request_id;
    }
}

# Canonical host: serve the certificate for www, then redirect to the apex domain.
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    return 301 https://${DOMAIN}$request_uri;
}

# Reject requests that do not match our domain.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 444;
}
